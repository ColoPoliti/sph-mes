# Copiar como .env.local y ajustar. Todas son opcionales.

# --- Monitoreo (MQTT por WebSocket; el usuario debe ser de SOLO LECTURA) ---
VITE_MQTT_URL=ws://10.200.1.243:9001
VITE_MQTT_USER=web_lectura
# La contraseña MQTT se pide al equipo (no se sube a git)
VITE_MQTT_PASS=
VITE_BROKER_ETIQUETA=10.200.1.243

# --- API PHP (en desarrollo /api la redirige el proxy de Vite) ---
VITE_API_BASE=/api

# --- Credenciales PROVISORIAS (se validan en el navegador hasta tener login real) ---
# Si no se definen, usuario = contraseña = nombre del perfil (admin, calidad, compras, usuario)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=
VITE_CALIDAD_USER=calidad
VITE_CALIDAD_PASS=
VITE_COMPRAS_USER=compras
VITE_COMPRAS_PASS=
VITE_USUARIO_USER=usuario
VITE_USUARIO_PASS=
