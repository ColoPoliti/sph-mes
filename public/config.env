# =====================================================================
#  SPH MES - Configuración del servidor
# =====================================================================
#  Este archivo queda en la raíz del sitio (junto a index.html).
#  Se edita con cualquier editor de texto y se aplica al RECARGAR la
#  página (F5). No hace falta volver a compilar.
#
#  Formato: CLAVE=valor   (una por línea; "#" = comentario)
#  Una clave vacía usa el valor grabado al compilar o el de fábrica.
#
#  ATENCIÓN: este archivo se descarga en el navegador de cada usuario.
#  Cualquiera puede leerlo: el usuario MQTT debe ser de SOLO LECTURA.
# =====================================================================

# --- Broker MQTT (monitoreo en vivo, por WebSocket) ---
# Sitio por HTTP:  ws://IP_BROKER:9001
# Sitio por HTTPS: wss://DOMINIO/mqtt  (con proxy /mqtt en el servidor web)
MQTT_URL=ws://10.200.1.243:9001
MQTT_USER=web_lectura
MQTT_PASS=
# Texto que se muestra en la barra de estado
BROKER_ETIQUETA=10.200.1.243

# --- API PHP (lotes, órdenes) ---
# Ruta que el servidor web redirige a la API (proxy /api -> http://IP_API:8080)
API_BASE=/api

# --- Usuarios por perfil (PROVISORIO, hasta tener login real) ---
# Si se dejan vacíos: usuario = contraseña = nombre del perfil (ej. admin/admin)
ADMIN_USER=
ADMIN_PASS=
PRODUCCION_USER=
PRODUCCION_PASS=
ELABORADOR_USER=
ELABORADOR_PASS=
LINEA_USER=
LINEA_PASS=
AUDITORIA_USER=
AUDITORIA_PASS=
CALIDAD_USER=
CALIDAD_PASS=
COMPRAS_USER=
COMPRAS_PASS=
USUARIO_USER=
USUARIO_PASS=
